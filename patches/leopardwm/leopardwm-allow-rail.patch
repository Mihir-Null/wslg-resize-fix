+/// Local patch (wslg-resize-fix): WSLg windows (msrdc.exe `RAIL_WINDOW`) stay
+/// excluded by class, except top-level ones, which WSLg titles
+/// "<title> (<distro>)". WSLg popups, menus and tooltips are untitled
+/// `RAIL_WINDOW`s with identical styles, so the title is what tells them apart.
+/// For the Linux app to follow a tiled size, WSLg needs
+/// https://github.com/Mihir-Null/wslg-resize-fix.
+pub(crate) fn is_wslg_toplevel(class_name: &str, title: &str) -> bool {
+    class_name == "RAIL_WINDOW" && title.ends_with(')') && title.contains(" (")
+}
+
+/// Window title, or empty.
+pub(crate) fn window_title(hwnd: HWND) -> String {
+    let len = unsafe { GetWindowTextLengthW(hwnd) };
+    if len <= 0 {
+        return String::new();
+    }
+    let mut buf: Vec<u16> = vec![0; (len + 1) as usize];
+    let n = unsafe { GetWindowTextW(hwnd, &mut buf) };
+    String::from_utf16_lossy(&buf[..n.max(0) as usize])
+}
+
 /// Check if a window should be skipped based on its class name.
 pub(crate) fn should_skip_window_by_class(class_name: &str) -> bool {
     const SKIP_CLASSES: &[&str] = &[
@@ -1111,3 +1136,24 @@ mod tests {
         assert!(!should_skip_window_by_class("IMEWindow"));
     }
 }
+
+#[cfg(test)]
+mod wslg_toplevel_tests {
+    use super::{is_wslg_toplevel, should_skip_window_by_class};
+
+    #[test]
+    fn rail_windows_are_admitted_only_with_the_wslg_distro_suffix() {
+        assert!(should_skip_window_by_class("RAIL_WINDOW"));
+        assert!(is_wslg_toplevel(
+            "RAIL_WINDOW",
+            "*scratch* - GNU Emacs at host (NixOS)"
+        ));
+        assert!(is_wslg_toplevel(
+            "RAIL_WINDOW",
+            "user@host: ~ (Ubuntu-24.04)"
+        ));
+        assert!(!is_wslg_toplevel("RAIL_WINDOW", "")); // popup / menu / tooltip
+        assert!(!is_wslg_toplevel("RAIL_WINDOW", "untitled"));
+        assert!(!is_wslg_toplevel("Chrome_WidgetWin_1", "page (site)"));
+    }
+}
